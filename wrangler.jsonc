{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "projthread",
  "compatibility_date": "2026-08-26",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/admin",
      "/admin/*",
      "/wiki",
      "/config",
      "/room/*"
    ]
  },
  "vars": {
    // Local wrangler dev overrides APP_ORIGIN via gitignored `.dev.vars`.
    // Leave ADMIN_DEV_SECRET unset on this Worker.
    "APP_ORIGIN": "https://projthread.jgabrielgruber.workers.dev",
    "TEAM_DOMAIN": "https://jgabrielgruber.cloudflareaccess.com",
    "POLICY_AUD": "6240d1948e5721d99f2a8d02a14a46085c639f65809dc04f54f09d96bbc50fdb"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projthread",
      "database_id": "91f78669-5146-42f5-8cfa-b14bf5e4346e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "projthread-blobs"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "NOTIFY", "queue": "projthread-notify" }
    ],
    "consumers": [
      {
        "queue": "projthread-notify",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "Room" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
